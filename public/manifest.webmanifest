{
  "name": "MOONSHOT NINE",
  "short_name": "Moonshot Nine",
  "description": "An original arcade baseball game. Ten clubs, eight parks, one cup.",
  "start_url": "./",
  "scope": "./",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "orientation": "landscape",
  "background_color": "#0b1020",
