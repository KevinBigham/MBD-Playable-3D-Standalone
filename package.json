{
  "name": "mr-baseball-dynasty",
  "private": true,
  "version": "1.0.0",
  "description": "Mr. Baseball Dynasty — an original arcade baseball game for the browser, on desktop or phone.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "phone": "npm run build && vite preview --host --port 4173",
    "icons": "tsx scripts/icons.ts",
    "shots": "tsx scripts/model-shot.ts",
    "test": "vitest run",
    "test:phone": "tsx scripts/phone-check.ts",
    "test:world": "tsx scripts/world-check.ts",
    "test:watch": "vitest",
    "sim": "tsx scripts/simulate.ts",
    "hitting": "tsx scripts/hitting.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/three": "^0.169.0",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
